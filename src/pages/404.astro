---
import BaseLayout from '../layouts/BaseLayout.astro';

const t = {
  meta: {
    title: 'Page not found — Kriangsit Pranee',
    description: 'The page you are looking for does not exist.',
  },
};
---

<BaseLayout t={t} lang="en">
  <main
    class="mx-auto flex min-h-screen max-w-4xl flex-col items-center justify-center px-5 text-center"
  >
    <p class="text-6xl font-bold text-brand-700 dark:text-white">404</p>
    <h1 class="mt-4 text-xl font-semibold text-slate-800 dark:text-slate-200">Page not found</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      ไม่พบหน้าที่คุณกำลังหา / The page you are looking for does not exist.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-600"
    >
      Back to home
    </a>
  </main>
</BaseLayout>
