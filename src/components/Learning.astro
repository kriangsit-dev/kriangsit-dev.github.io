---
import Section from './Section.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
---

<Section id="learning" title={t.learning.title}>
  <p class="max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-400">
    {t.learning.intro}
  </p>

  <div class="mt-5 flex flex-wrap gap-1.5">
    {
      t.learning.items.map((item: string) => (
        <span class="rounded-md border border-dashed border-slate-300 px-2.5 py-1 text-sm text-slate-600 dark:border-slate-600 dark:text-slate-400">
          {item}
        </span>
      ))
    }
  </div>
</Section>
